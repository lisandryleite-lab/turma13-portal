generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  matricula    Int       @unique
  nomeGuerra   String
  nomeCompleto String
  email        String    @unique
  password     String
  isAdmin      Boolean   @default(false)
  aniversario  String?
  canga        String?
  cangaPar     Int?     // matrícula do par de canga
  grupoPlantao String?
  grupoFaxina  String?
  alojamento   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  notas         Nota[]
  notasAlteradas HistoricoNota[] @relation("AlteradoPor")
  escalasAluno  EscalaAluno[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Aviso {
  id        String   @id @default(cuid())
  titulo    String
  corpo     String
  fixado    Boolean  @default(false)
  destaque  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Nota {
  id          String   @id @default(cuid())
  userId      String
  disciplina  String
  avaliacao   String
  nota        Float
  peso        Float    @default(1)
  ehAF        Boolean  @default(false)
  apto        Boolean  @default(false)
  data        DateTime
  observacao  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  historico HistoricoNota[]
}

model HistoricoNota {
  id            String   @id @default(cuid())
  notaId        String
  alteradoPorId String
  tipo          String   // criacao | edicao | exclusao
  campoAlterado String?
  valorAnterior String?
  valorNovo     String?
  disciplina    String
  avaliacao     String
  observacao    String?
  createdAt     DateTime @default(now())

  nota        Nota @relation(fields: [notaId], references: [id], onDelete: Cascade)
  alteradoPor User @relation("AlteradoPor", fields: [alteradoPorId], references: [id])
}

model EscalaTurmaFaxina {
  id         String   @id @default(cuid())
  data       DateTime
  posicao    String
  userId     String
  canga      String?
  observacao String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EscalaTurmaServico {
  id         String   @id @default(cuid())
  data       DateTime
  posicao    String
  userId     String
  canga      String?
  observacao String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EscalaAluno {
  id        String   @id @default(cuid())
  userId    String
  tipo      String   // Plantão | Faxina de Alojamento | Outro
  nome      String?
  data      DateTime
  horaInicio String?
  horaFim   String?
  funcao    String?
  local     String?
  descricao String?
  observacao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Missao {
  id        String   @id @default(cuid())
  semana    Int      @unique
  titulo    String
  corpo     String
  createdAt DateTime @default(now())
}

model Disciplina {
  id               String @id @default(cuid())
  sigla            String @unique
  nome             String
  modulo           String
  cargaTotal       Int
  cargaMinistrada  Int    @default(0)
  status           String @default("Início")
}

model QTS {
  id        String   @id @default(cuid())
  semana    Int      @unique
  dados     Json
  createdAt DateTime @default(now())
}

model Xerife {
  id         String    @id @default(cuid())
  matricula  Int
  nomeGuerra String
  dataInicio DateTime
  dataFim    DateTime?
  atual      Boolean   @default(false)
}

model EscalaServico {
  id        String @id @default(cuid())
  semana    Int    @unique
  subXerife Int?
  p1        Int?
  p3        Int?
  p4        Int?
}

model EscalaFaxina {
  id     String @id @default(cuid())
  semana Int
  grupo  String
  local  String
}

model EscalaPlantao {
  id     String @id @default(cuid())
  semana Int
  grupo  String
  tipo   String
}

// Plantão externo (2ª CIA) — admin insere mensalmente
model PlantaoDia {
  id           String   @id @default(cuid())
  data         DateTime @unique
  grupoPlantao String   // LIMA | GOLF | HOTEL | INDIA | JULIETT | KILO
  adjuntoMat   Int?     // matrícula do adjunto da 2ª CIA (só se for da Turma 13)
  createdAt    DateTime @default(now())
}

// Funções de Destaque externas — admin insere mensalmente
model FuncaoDestaqueDia {
  id        String   @id @default(cuid())
  data      DateTime
  funcao    String   // Mestre | Leitor | Discurso | Comandante
  matricula Int
  createdAt DateTime @default(now())

  @@unique([data, funcao])
}

// Referência para cálculo automático da faxina
model FaxinaRef {
  id            String   @id @default(cuid())
  dataRef       DateTime @unique // dia útil conhecido
  grupoRef      String            // grupo que fez faxina nesse dia (G1..G8)
  createdAt     DateTime @default(now())
}
