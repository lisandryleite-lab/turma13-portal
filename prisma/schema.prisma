generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  matricula    Int       @unique
  nomeGuerra   String
  nomeCompleto String
  email        String    @unique
  password     String
  isAdmin      Boolean   @default(false)
  financeiroAdmin Boolean @default(false) // gere o módulo Financeiro sem ser admin geral
  turma        Int?      // 1, 2 ou 3 — turma do CFO (pelotão é irrelevante, não modelado)
  turma13      Boolean   @default(false) // membro do pelotão "Turma 13" (1º Pelotão) — acesso ao portal T13
  ativo        Boolean   @default(true) // aluno ativo = consta na escala de plantão
  aniversario  String?
  canga        String?
  cangaPar     Int?     // matrícula do par de canga
  grupoPlantao String?
  grupoFaxina  String?
  alojamento   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  notas         Nota[]
  notasAlteradas   HistoricoNota[]   @relation("AlteradoPor")
  notasCfo         NotaCFO[]
  notasCfoAlteradas HistoricoNotaCFO[] @relation("CfoAlteradoPor")
  preferenciaOpm   PreferenciaOPM?
  respostas        Resposta[]
  escalasAluno     EscalaAluno[]
  missoesConcluidas MissaoConcluida[]
  nfdc              Float   @default(10)
  pagamentosCota    PagamentoCota[]
  pedidosLanche     PedidoLancheAluno[]
  permutaOfertas           PermutaOferta[]
  permutaSolicitacoesCriadas PermutaSolicitacao[]
  permutaParticipacoes      PermutaParticipante[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Aviso {
  id        String   @id @default(cuid())
  titulo    String
  corpo     String
  fixado    Boolean  @default(false)
  destaque  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Nota {
  id          String   @id @default(cuid())
  userId      String
  disciplina  String
  avaliacao   String
  nota        Float
  peso        Float    @default(1)
  ehAF        Boolean  @default(false)
  apto        Boolean  @default(false)
  data        DateTime
  observacao  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  historico HistoricoNota[]
}

model HistoricoNota {
  id            String   @id @default(cuid())
  notaId        String
  alteradoPorId String
  tipo          String   // criacao | edicao | exclusao
  campoAlterado String?
  valorAnterior String?
  valorNovo     String?
  disciplina    String
  avaliacao     String
  observacao    String?
  createdAt     DateTime @default(now())

  nota        Nota @relation(fields: [notaId], references: [id], onDelete: Cascade)
  alteradoPor User @relation("AlteradoPor", fields: [alteradoPorId], references: [id])
}

model EscalaTurmaFaxina {
  id         String   @id @default(cuid())
  data       DateTime
  posicao    String
  userId     String
  canga      String?
  observacao String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EscalaTurmaServico {
  id         String   @id @default(cuid())
  data       DateTime
  posicao    String
  userId     String
  canga      String?
  observacao String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EscalaAluno {
  id        String   @id @default(cuid())
  userId    String
  tipo      String   // Plantão | Faxina de Alojamento | Outro
  nome      String?
  data      DateTime
  horaInicio String?
  horaFim   String?
  funcao    String?
  local     String?
  descricao String?
  observacao String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Missao {
  id         String             @id @default(cuid())
  semana     Int                @unique
  titulo     String
  corpo      String
  concluida  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  conclusoes MissaoConcluida[]
}

model MissaoConcluida {
  id        String   @id @default(cuid())
  missaoId  String
  userId    String
  createdAt DateTime @default(now())

  missao Missao @relation(fields: [missaoId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([missaoId, userId])
}

model Disciplina {
  id               String @id @default(cuid())
  sigla            String @unique
  nome             String
  modulo           String
  cargaTotal       Int
  cargaMinistrada  Int    @default(0)
  status           String @default("Início")
}

model QTS {
  id        String   @id @default(cuid())
  semana    Int      @unique
  dados     Json
  createdAt DateTime @default(now())
}

model Xerife {
  id         String    @id @default(cuid())
  matricula  Int
  nomeGuerra String
  dataInicio DateTime
  dataFim    DateTime?
  atual      Boolean   @default(false)
}

model EscalaServico {
  id        String @id @default(cuid())
  semana    Int    @unique
  subXerife Int?
  p1        Int?
  p3        Int?
  p4        Int?
}

model EscalaFaxina {
  id     String @id @default(cuid())
  semana Int
  grupo  String
  local  String
}

model EscalaPlantao {
  id     String @id @default(cuid())
  semana Int
  grupo  String
  tipo   String
}

// Plantão externo (2ª CIA) — admin insere mensalmente
model PlantaoDia {
  id           String   @id @default(cuid())
  data         DateTime @unique
  grupoPlantao String   // LIMA | GOLF | HOTEL | INDIA | JULIETT | KILO
  adjuntoMat   Int?     // matrícula do adjunto da 2ª CIA (só se for da Turma 13)
  createdAt    DateTime @default(now())
}

// Funções de Destaque externas — admin insere mensalmente
model FuncaoDestaqueDia {
  id        String   @id @default(cuid())
  data      DateTime
  funcao    String   // Mestre | Leitor | Discurso | Comandante
  matricula Int
  createdAt DateTime @default(now())

  @@unique([data, funcao])
}

// Composição dos grupos de faxina — editável pelo admin
model FaxinaGrupoMembro {
  id    String @id @default(cuid())
  grupo String  // G1–G8
  mat   Int
  nome  String

  @@unique([grupo, mat])
  @@index([grupo])
}

// Referência para cálculo automático da faxina
model FaxinaRef {
  id            String   @id @default(cuid())
  dataRef       DateTime @unique // dia útil conhecido
  grupoRef      String            // grupo que fez faxina nesse dia (G1..G8)
  createdAt     DateTime @default(now())
}

// ── CFO 2026 — Ranking (notas autodeclaradas) ──────────────────
// Notas que o próprio aluno lança para simular sua posição.
// NUNCA são oficiais — sempre tratar como simulação.
model NotaCFO {
  id            String   @id @default(cuid())
  userId        String
  disciplina    String   // sigla da Disciplina (ex.: LPMO, TCC)
  avaliacao     String   @default("P1") // P1, P2, AF, TCC...
  valor         Float
  ehAF          Boolean  @default(false) // Avaliação Final (entra no cálculo de MDR)
  apto          Boolean  @default(false) // disciplina de conceito APTO/INAPTO (fora da MFIC)
  autodeclarada Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  historico HistoricoNotaCFO[]

  @@unique([userId, disciplina, avaliacao])
}

model HistoricoNotaCFO {
  id            String   @id @default(cuid())
  notaCfoId     String
  alteradoPorId String
  tipo          String   // criacao | edicao | exclusao
  valorAnterior String?
  valorNovo     String?
  disciplina    String
  avaliacao     String?
  createdAt     DateTime @default(now())

  notaCfo     NotaCFO @relation(fields: [notaCfoId], references: [id], onDelete: Cascade)
  alteradoPor User    @relation("CfoAlteradoPor", fields: [alteradoPorId], references: [id])
}

// ── CFO 2026 — Notas históricas (T1/T2) para previsão por percentil ──
// Notas finais OFICIAIS de turmas anteriores. Base estatística da previsão.
// Não têm relação com User (são de outras turmas).
model NotaHistorica {
  id           String @id @default(cuid())
  turma        Int    // 1 (T1) ou 2 (T2)
  valorFinal   Float
  posicaoFinal Int?

  @@index([turma])
}

// ── CFO 2026 — Preferência de Batalhão (OPM) ──────────────────
// Lista fechada de OPMs (área da DIM / RMR) cadastrada pelo Adm.
model OPM {
  id       String  @id @default(cuid())
  sigla    String  @unique
  nome     String
  especial Boolean @default(false) // "não decidiu / não faz diferença"
  ordem    Int     @default(0)

  prefsOpcao1 PreferenciaOPM[] @relation("Opcao1")
  prefsOpcao2 PreferenciaOPM[] @relation("Opcao2")
  prefsOpcao3 PreferenciaOPM[] @relation("Opcao3")
}

model PreferenciaOPM {
  id        String   @id @default(cuid())
  userId    String   @unique
  opcao1Id  String
  opcao2Id  String?
  opcao3Id  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  opcao1 OPM  @relation("Opcao1", fields: [opcao1Id], references: [id])
  opcao2 OPM? @relation("Opcao2", fields: [opcao2Id], references: [id])
  opcao3 OPM? @relation("Opcao3", fields: [opcao3Id], references: [id])
}

// ── CFO 2026 — Questões (banco de questões por matéria) ──────────────
model Questao {
  id           String   @id @default(cuid())
  materia      String   // sigla da Disciplina (ex.: LPMO)
  modulo       String   @default("")
  tipo         String   @default("multipla") // multipla | certo_errado | dissertativa
  contexto     String?  // caso prático / situação (MC com ctx)
  enunciado    String
  alternativas Json     // multipla: [{id:"A",texto:"..."}]; demais: []
  gabarito     String   @default("") // "A".."E" ou "certo"/"errado"; vazio em dissertativa
  explicacao   String?  // gabarito comentado (MC) ou justificativa do erro (VF)
  modelo       Json?    // dissertativa: { estrutura, criterios:[], resposta }
  fonte        String?
  hash         String   @unique // sha1(materia|modulo|enunciado) — import idempotente
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  respostas    Resposta[]
  @@index([materia])
}

model Resposta {
  id        String   @id @default(cuid())
  userId    String
  questaoId String
  resposta  String   // o que o aluno marcou
  acertou   Boolean
  modo      String   @default("resolver") // resolver | simulado
  data      DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questao Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([questaoId])
}

// ── CFO 2026 — Mementos & Flashcards (Fase 7) ──────────────────
model Memento {
  id         String   @id @default(cuid())
  materia    String   // sigla da Disciplina
  modulo     String   @default("")
  titulo     String
  conteudoMd String   // conteúdo em Markdown (renderizado com design CFO)
  ordem      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([materia, modulo, titulo])
  @@index([materia])
}

model Flashcard {
  id        String   @id @default(cuid())
  materia   String
  modulo    String   @default("")
  frente    String
  verso     String
  ordem     Int      @default(0)
  hash      String   @unique // sha1(materia|modulo|frente) — import idempotente
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([materia])
}

// ── CFO 2026 — Gaivotas (chat colaborativo por matéria) ──────────
model Gaivota {
  id         String   @id @default(cuid())
  materia    String   // sigla da Disciplina
  matricula  Int      // autor (snapshot)
  nomeGuerra String   // autor (snapshot)
  texto      String
  createdAt  DateTime @default(now())

  @@index([materia, createdAt])
}

// ── CFO 2026 — Financeiro (cotas e cobranças do pelotão) ──────────
model CotaFinanceira {
  id          String   @id @default(cuid())
  titulo      String
  token       String   @unique @default(cuid()) // link coletivo público (todos acessam e acham o próprio nome)
  tipo        String   @default("mensal") // mensal | extra
  valor       Float
  responsavel String   // quem recebe/centraliza (nome de guerra)
  instrucoes  String?  // forma de pagamento + onde enviar comprovante
  driveFolderUrl String? // pasta do Google Drive com os comprovantes da cota
  prazo       DateTime?
  ativa       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pagamentos PagamentoCota[]
}

model PagamentoCota {
  id            String    @id @default(cuid())
  cotaId        String
  userId        String
  pago          Boolean   @default(false) // confirmado pelo tesoureiro
  dataPagamento DateTime?
  declaradoPago Boolean   @default(false) // o aluno declarou "já fiz o Pix" (via link público) — aguarda confirmação
  dataDeclarado DateTime?
  token         String    @unique @default(cuid()) // link público de pagamento, sem login
  observacao    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cota CotaFinanceira @relation(fields: [cotaId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cotaId, userId])
  @@index([userId])
}

// ── CFO 2026 — Lanche coletivo (pedido em grupo) ─────────────────
model PedidoLanche {
  id          String   @id @default(cuid())
  titulo      String
  token       String   @unique @default(cuid()) // link coletivo público
  restaurante String?
  responsavel String   // quem centraliza/recebe (nome de guerra)
  instrucoes  String?  // forma de pagamento (Pix etc.)
  driveFolderUrl String? // pasta do Google Drive com os comprovantes
  prazo       DateTime?
  aberto      Boolean  @default(true) // aceita novos pedidos?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens   ItemLanche[]
  pedidos PedidoLancheAluno[]
}

model ItemLanche {
  id       String  @id @default(cuid())
  pedidoId String
  nome     String
  preco    Float
  ordem    Int     @default(0)

  pedido  PedidoLanche       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  linhas  LinhaPedidoLanche[]

  @@index([pedidoId])
}

model PedidoLancheAluno {
  id            String    @id @default(cuid())
  pedidoId      String
  userId        String
  pago          Boolean   @default(false) // confirmado pelo tesoureiro
  dataPagamento DateTime?
  declaradoPago Boolean   @default(false)
  dataDeclarado DateTime?
  token         String    @unique @default(cuid()) // link público (pagamento sem login)
  observacao    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pedido PedidoLanche        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  linhas LinhaPedidoLanche[]

  @@unique([pedidoId, userId])
  @@index([userId])
}

model LinhaPedidoLanche {
  id              String @id @default(cuid())
  pedidoAlunoId   String
  itemId          String
  quantidade      Int    @default(1)

  pedidoAluno PedidoLancheAluno @relation(fields: [pedidoAlunoId], references: [id], onDelete: Cascade)
  item        ItemLanche        @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([pedidoAlunoId, itemId])
  @@index([pedidoAlunoId])
}

// ── CFO 2026 — Permuta de Plantões ──────────────────────────────
// Lotação completa das 8 equipes de plantão (Turma 13 + demais militares da 2ª CIA).
// Fonte: Mapa de Equipes de Plantão (PMPE/APMP/CFO 2026). Seedado uma vez; editável pelo admin.
model MilitarPlantao {
  id           String   @id @default(cuid())
  matricula    Int      @unique
  nome         String
  grupoPlantao String   // GOLF | HOTEL | INDIA | JULIETT | KILO | LIMA | MIKE | NOVEMBER
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Oferta aberta de um aluno Turma 13: "quero ceder este dia, gostaria de receber aquele"
model PermutaOferta {
  id        String   @id @default(cuid())
  userId    String
  cedeData  DateTime
  querData  DateTime? // legado — não usado no fluxo simplificado (só marca o dia que quer largar)
  status    String   @default("aberta") // aberta | fechada | cancelada
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cedeData])
  @@index([userId])
}

// Uma permuta (direta ou triangular) em construção/rastreamento.
// Não altera PlantaoDia — é só documentação/combinado entre as partes,
// formalizado depois via processo SEI (número preenchido manualmente).
model PermutaSolicitacao {
  id            String   @id @default(cuid())
  criadoPorId   String
  status        String   @default("pendente") // pendente | aceita | recusada | cancelada
  seiNumero     String?
  seiObservacao String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  criadoPor     User                  @relation(fields: [criadoPorId], references: [id])
  participantes PermutaParticipante[]
}

// Cada perna da cadeia: esta pessoa cede cedeData (pra quem vem a seguir na ordem;
// ordem 1 cede pro 2, o último fecha o ciclo cedendo pro 1º — direto = 2 pernas, triangular = 3).
model PermutaParticipante {
  id            String    @id @default(cuid())
  solicitacaoId String
  ordem         Int       // 1 = quem criou, 2 = parceiro, 3 = terceiro (triangular, opcional)
  userId        String?   // preenchido só se for aluno Turma 13 com login
  matricula     Int
  nome          String    // snapshot (cobre militares externos sem User)
  grupoPlantao  String    // snapshot no momento da criação
  cedeData      DateTime
  status        String    @default("pendente") // pendente | aceito | recusado
  respondidoEm  DateTime?

  solicitacao PermutaSolicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  user        User?              @relation(fields: [userId], references: [id])

  @@index([solicitacaoId])
  @@index([userId])
}

// ── CFO 2026 — Log de acesso (LGPD / auditoria) ──────────────────
model LogAcesso {
  id         String   @id @default(cuid())
  userId     String
  matricula  Int
  nomeGuerra String
  area       String   // ex.: painel-admin | questoes/import | mementos/import
  acao       String   // descrição da ação
  timestamp  DateTime @default(now())

  @@index([timestamp])
}
