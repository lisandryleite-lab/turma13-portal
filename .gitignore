# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

.vercel

# claude code
.claude/

# dados-fonte (PII — nunca commitar: planilhas/PDFs de alunos)
/.dados-fonte/

# insumos de conteúdo (texto bruto de apostilas p/ gerar questões/mementos)
/_*.txt

# mídias pesadas (vídeo/áudio) ficam no Google Drive — no repo só o link.
# Arquivos leves (mapa mental em PDF/imagem) podem ficar em public/midias/.
/public/midias/**/*.mp4
/public/midias/**/*.m4v
/public/midias/**/*.mov
/public/midias/**/*.webm
/public/midias/**/*.m4a
/public/midias/**/*.mp3
/public/midias/**/*.wav
